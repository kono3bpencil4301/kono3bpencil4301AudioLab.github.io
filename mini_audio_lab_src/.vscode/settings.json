{
    "files.exclude": {
        "**/*.rpyc": true,
        "**/*.rpa": true,
        "**/*.rpymc": true,
        "**/cache/": true
    },
    "code-runner.executorMap": {
        "cpp": "cd $dir && g++ -fdiagnostics-color=always -g *.cpp -o $fileNameWithoutExt.exe && $fileNameWithoutExt.exe"
    }
}